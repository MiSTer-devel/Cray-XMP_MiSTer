+ *  The records are held in pieces of DA_PIECE records, so that a file
+ *  takes the room of its records and no more, and grows without being
+ *  copied.  A file that a second unit opens is the one in memory: both
+ *  units see the same records, and the file is written back when the
+ *  last of them closes it.
+ */
+#define DA_PIECE       64
+#define DA_PIECE_SHIFT 6
+
+static DaFile daFiles[MAX_ALLOCATED_UNITS];
+
+static char *daPtr(DaFile *fp, int rec) {
+    return fp->pieces[(rec - 1) >> DA_PIECE_SHIFT] + ((rec - 1) & (DA_PIECE - 1)) * fp->recLen;
+}
+
+static int daReserve(DaFile *fp, int recs) {
+    int i;
+    int n;
+    char **nt;
+    char *piece;
+
+    while (recs > fp->recs) {
+        n = fp->recs >> DA_PIECE_SHIFT;
+        if ((n & (n - 1)) == 0) { /* the table of pieces is full: twice the size */
+            nt = (char **)malloc(((n > 0) ? n * 2 : 1) * sizeof(char *));
+            if (nt == NULL) return ENOMEM;
+            for (i = 0; i < n; i++) nt[i] = fp->pieces[i];
+            if (fp->pieces != NULL) free(fp->pieces);
+            fp->pieces = nt;
+        }
+        piece = (char *)malloc(DA_PIECE * fp->recLen);
+        if (piece == NULL) return ENOMEM;
+        memset(piece, fp->unformatted ? 0 : ' ', DA_PIECE * fp->recLen);
+        fp->pieces[n] = piece;
+        fp->recs += DA_PIECE;
+    }
+    return 0;
+}
+
+static int daRead(Unit *up, char *dst, int n) {
+    if (up->daRec > up->da->max) return -1; /* no such record */
+    if (up->daPos + n > up->recLen) return EIO; /* longer than a record */
+    memcpy(dst, daPtr(up->da, up->daRec) + up->daPos, n);
+    up->daPos += n;
+    return 0;
+}
+
+static int daWrite(Unit *up, char *src, int n) {
+    int rc;
+
+    if (up->daPos + n > up->recLen) return EIO; /* longer than a record */
+    rc = daReserve(up->da, up->daRec);
+    if (rc != 0) return rc;
+    memcpy(daPtr(up->da, up->daRec) + up->daPos, src, n);
+    up->daPos += n;
+    if (up->daRec > up->da->max) up->da->max = up->daRec;
+    up->da->dirty = 1;
+    return 0;
+}
+
+static int daLoad(DaFile *fp) {
+    int fd;
+    int have;
+    int n;
+    int pieceLen;
+    int rc;
+
+    fd = open(fp->fileName, O_RDONLY|O_BINARY, 0);
+    if (fd == -1) return errno;
+    have = 0;
+    rc = 0;
+    pieceLen = DA_PIECE * fp->recLen;
+    for (;;) {
+        rc = daReserve(fp, have / fp->recLen + 1);
+        if (rc != 0) break;
+        n = read(fd, fp->pieces[have / pieceLen] + have % pieceLen, pieceLen - have % pieceLen);
+        if (n < 0) {
+            rc = errno;
+            break;
+        }
+        if (n == 0) break;
+        have += n;
+    }
+    close(fd);
+    fp->max = have / fp->recLen;
+    return rc;
+}
+
+static int daSave(DaFile *fp) {
+    int fd;
+    int i;
+    int len;
+    int n;
+    int rc;
+
+    fd = open(fp->fileName, O_CREAT|O_TRUNC|O_WRONLY|O_BINARY, 0640);
+    if (fd == -1) return errno;
+    rc = 0;
+    len = fp->max * fp->recLen;
+    for (i = 0; len > 0 && rc == 0; i++) {
+        n = (len < DA_PIECE * fp->recLen) ? len : DA_PIECE * fp->recLen;
+        if (write(fd, fp->pieces[i], n) != n) rc = errno;
+        len -= n;
+    }
+    if (close(fd) == -1 && rc == 0) rc = errno;
+    return rc;
+}
+
+/*
+ *  daOpen - the file of a name for a unit: the one another unit has open,
+ *  or a new one, read in if doLoad is set
+ */
+static int daOpen(Unit *up, char *fileName, int recLen, int unformatted, int doLoad) {
+    DaFile *fp;
+    DaFile *freeSlot;
+    int i;
+    int rc;
+
+    freeSlot = NULL;
+    for (i = 0; i < MAX_ALLOCATED_UNITS; i++) {
+        fp = &daFiles[i];
+        if (fp->users == 0) {
+            if (freeSlot == NULL) freeSlot = fp;
+        }
+        else if (strcmp(fp->fileName, fileName) == 0) {
+            if (fp->recLen != recLen) return EINVAL;
+            fp->users += 1;
+            up->da = fp;
+            return 0;
+        }
+    }
+    if (freeSlot == NULL) return ENFILE;
+    fp = freeSlot;
+    memset(fp, 0, sizeof(DaFile));
+    strcpy(fp->fileName, fileName);
+    fp->recLen = recLen;
+    fp->unformatted = unformatted;
+    fp->users = 1;
+    up->da = fp;
+    if (doLoad) {
+        rc = daLoad(fp);
+        if (rc != 0) {
+            daClose(up, 0);
+            return rc;
+        }
+    }
+    return 0;
+}
+
+/*
+ *  daClose - a unit gives its file up; the last one writes it back, or
+ *  with doDelete only lets it go
+ */
+static int daClose(Unit *up, int doDelete) {
+    DaFile *fp;
+    int i;
+    int rc;
+
+    fp = up->da;
+    up->da = NULL;
+    if (fp == NULL) return 0;
+    rc = 0;
+    fp->users -= 1;
+    if (fp->users > 0) return 0;
+    if (doDelete == 0 && fp->dirty) rc = daSave(fp);
+    if (fp->pieces != NULL) {
+        for (i = 0; i < (fp->recs >> DA_PIECE_SHIFT); i++) free(fp->pieces[i]);
+        free(fp->pieces);
+    }
+    memset(fp, 0, sizeof(DaFile));
+    return rc;
+}
