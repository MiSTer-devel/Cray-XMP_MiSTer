+/*
+ *  A Hollerith constant: up to eight characters left-justified in a word
+ *  and blank-filled, as CFT77 holds a character constant in a numeric
+ *  context.  Longer constants are cut to the word.
+ */
+i64 hollerithValue(CharacterValue *cv) {
+    u64 v;
+    int i;
+    u8 c;
+
+    if (cv->length > 8) warn("Hollerith constant longer than 8 characters truncated");
+    v = 0;
+    for (i = 0; i < 8; i++) {
+        c = (i < cv->length && cv->string != NULL) ? (u8)cv->string[i] : (u8)' ';
+        v = (v << 8) | c;
+    }
+    return (i64)v;
+}
+
+static BaseType coerceCharToInt(OperatorArgument *arg, BaseType fromType, BaseType toType) {
+    i64 v;
+
+    if (doHollerith == FALSE || arg->class != ArgClass_Constant) return BaseType_Undefined;
+    v = hollerithValue(&arg->details.constant.value.character);
+    if (arg->details.constant.value.character.string != NULL) free(arg->details.constant.value.character.string);
+    arg->details.constant.dt.type = toType;
+    arg->details.constant.dt.constraint = 0;
+    if (toType == BaseType_Logical)
+        arg->details.constant.value.logical = (u64)v;
+    else
+        arg->details.constant.value.integer = v;
+    return toType;
+}
