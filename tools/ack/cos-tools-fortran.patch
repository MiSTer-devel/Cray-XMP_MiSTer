+/*--------------------------------------------------------------------------
+**
+**  Name: jumps.c
+**
+**  Description:
+**      Conditions compiled to jumps.
+**
+**      A relation is compiled as a value, all ones if it holds and zero if
+**      not, made with a jump:
+**
+**               S0        X              the relation
+**               Sr        <64
+**               Jc        *+3            Jc: JSZ, JSN, JSP or JSM
+**               Sr        0
+**
+**      .AND., .OR. and .NOT. combine such values (Sd Sa&Sb, Sd Sa!Sb,
+**      Sd #Sa), and an IF tests the result with S0 Sr and JSZ to the code
+**      that follows when the condition is false.  This pass reads the
+**      compiled program back and, where a block of code ends in such a
+**      test, compiles its condition as jumps instead: each relation is
+**      S0 X and one jump, .AND. jumps to the false label as soon as one
+**      relation fails, .OR. jumps past the rest as soon as one holds.
+**
+**      The code that loads the operands of a relation stays in front of
+**      it.  A relation after the first may be skipped, so its code must
+**      only set registers and read only what it has set itself, besides
+**      the stack and frame registers (A5, A6, A7).  A block that does not
+**      have exactly this form is left as it is.
+**
+**--------------------------------------------------------------------------
+*/
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "proto.h"
+
+#define MAX_FIELD  24
+#define MAX_NODES  128
+
+typedef struct line {
+    char *text;
+    char label[MAX_FIELD];  /* longer ones are taken for labels of their own */
+    char f1[MAX_FIELD];
+    char *f2;               /* the operand field, within text */
+    int  isComment;
+} Line;
+
+typedef enum { Node_Leaf, Node_And, Node_Or, Node_Not } NodeKind;
+
+typedef struct node {
+    NodeKind kind;
+    int a, b;          /* operands of And, Or, Not            */
+    int codeFirst;     /* leaf: the lines that load operands  */
+    int codeCount;
+    int test;          /* leaf: the line S0 X                 */
+    char cond[4];      /* leaf: the jump taken if it holds    */
+} Node;
+
+static Line   *lines;
+static int     lineCount;
+static FILE   *out;
+static int     labelCounter = 0;
+
+static Node    nodes[MAX_NODES];
+static int     nodeCount;
+static Line   *region;
+
+static char *copyField(char *dp, char *cp) {
+    int n;
+
+    n = 0;
+    while (*cp != '\0' && *cp != ' ' && *cp != '\t') {
+        if (n < MAX_FIELD - 1) dp[n++] = *cp;
+        else dp[0] = '?';            /* too long to be what is looked for */
+        cp += 1;
+    }
+    dp[n] = '\0';
+    return cp;
+}
+
+static void parseLine(Line *lp, char *text) {
+    char *cp;
+    char *ep;
+
+    lp->text = text;
+    lp->label[0] = lp->f1[0] = '\0';
+    lp->f2 = "";
+    lp->isComment = (*text == '*' || *text == '\0');
+    if (lp->isComment) return;
+    ep = text + strlen(text);
+    while (ep > text && (ep[-1] == ' ' || ep[-1] == '\t' || ep[-1] == '\r')) *--ep = '\0';
+    cp = text;
+    if (*cp != ' ' && *cp != '\t') {
+        cp = copyField(lp->label, cp);
+        if (lp->label[0] == '\0') lp->label[0] = '?';
+    }
+    while (*cp == ' ' || *cp == '\t') cp += 1;
+    cp = copyField(lp->f1, cp);
+    while (*cp == ' ' || *cp == '\t') cp += 1;
+    lp->f2 = cp;
+}
+
+/* Sn or An, n from lo to 7 */
+static int isReg(char *s, char kind, int lo) {
+    return s[0] == kind && s[1] >= '0' + lo && s[1] <= '7' && s[2] == '\0';
+}
+
+static int isJump(char *f1) {
+    return strcmp(f1, "JSZ") == 0 || strcmp(f1, "JSN") == 0
+        || strcmp(f1, "JSP") == 0 || strcmp(f1, "JSM") == 0;
+}
+
+static char *negation(char *cond) {
+    if (strcmp(cond, "JSZ") == 0) return "JSN";
+    if (strcmp(cond, "JSN") == 0) return "JSZ";
+    if (strcmp(cond, "JSP") == 0) return "JSM";
+    return "JSP";
+}
+
+/* a line that is code with no label, as opposed to a jump, a call, a label or a directive */
+static int isCode(Line *lp) {
+    char *f1;
+
+    if (lp->isComment || lp->label[0] != '\0') return 0;
+    f1 = lp->f1;
+    if (strchr(f1, ',') != NULL) return 1;              /* a store */
+    if (strcmp(f1, "VL") == 0 || strcmp(f1, "VM") == 0) return 1;
+    if ((f1[0] == 'S' || f1[0] == 'A' || f1[0] == 'B' || f1[0] == 'T' || f1[0] == 'V')
+        && f1[1] >= '0' && f1[1] <= '7') return 1;
+    return 0;
+}
+
+/* a line that sets a register (S1-S7, A1-A7) and does nothing else */
+static int isPlain(Line *lp) {
+    return lp->label[0] == '\0' && (isReg(lp->f1, 'S', 1) || isReg(lp->f1, 'A', 1));
+}
+
+/* the registers S1-S7 and A1-A7 an operand field reads, as a bit mask */
+static int regsRead(char *s) {
+    int mask;
+    char *cp;
+
+    mask = 0;
+    for (cp = s; *cp != '\0'; cp++) {
+        if ((*cp == 'S' || *cp == 'A') && cp[1] >= '0' && cp[1] <= '7'
+            && (cp == s || !isalnum((unsigned char)cp[-1]))
+            && !isalnum((unsigned char)cp[2])) {
+            mask |= 1 << (((*cp == 'S') ? 0 : 8) + cp[1] - '0');
+        }
+    }
+    return mask;
+}
+
+static int regBit(char *r) {
+    return 1 << (((r[0] == 'S') ? 0 : 8) + r[1] - '0');
+}
+
+static int isMaterialization(Line *lp) {
+    return lp[0].label[0] == '\0' && strcmp(lp[0].f1, "S0") == 0
+        && isReg(lp[1].f1, 'S', 1) && lp[1].label[0] == '\0' && strcmp(lp[1].f2, "<64") == 0
+        && isJump(lp[2].f1) && lp[2].label[0] == '\0' && strcmp(lp[2].f2, "*+3") == 0
+        && strcmp(lp[3].f1, lp[1].f1) == 0 && lp[3].label[0] == '\0' && strcmp(lp[3].f2, "0") == 0;
+}
+
+/* the code of a leaf after the first reads only what it sets itself */
+static int isSelfContained(Node *np) {
+    int i;
+    int written;
+
+    written = regBit("A5") | regBit("A6") | regBit("A7");
+    for (i = np->codeFirst; i < np->codeFirst + np->codeCount; i++) {
+        if ((regsRead(region[i].f2) & ~written) != 0) return 0;
+        written |= regBit(region[i].f1);
+    }
+    return (regsRead(region[np->test].f2) & ~written) == 0;
+}
+
+static void putLine(char *label, char *f1, char *f2) {
+    fprintf(out, "%-8s %-9s %s\n", label, f1, f2);
+}
+
+static void newLabel(char *label) {
+    sprintf(label, "%%P%05d", ++labelCounter);
+}
+
+static void genTrue(int n, char *t);
+
+static void genLeaf(Node *np, char *jump, char *target) {
+    int i;
+
+    for (i = np->codeFirst; i < np->codeFirst + np->codeCount; i++) fprintf(out, "%s\n", region[i].text);
+    putLine("", "S0", region[np->test].f2);
+    putLine("", jump, target);
+}
+
+static void genFalse(int n, char *f) {
+    char label[16];
+    Node *np;
+
+    np = &nodes[n];
+    switch (np->kind) {
+    case Node_Leaf:
+        genLeaf(np, negation(np->cond), f);
+        break;
+    case Node_And:
+        genFalse(np->a, f);
+        genFalse(np->b, f);
+        break;
+    case Node_Or:
+        newLabel(label);
+        genTrue(np->a, label);
+        genFalse(np->b, f);
+        putLine(label, "=", "*");
+        break;
+    case Node_Not:
+        genTrue(np->a, f);
+        break;
+    }
+}
+
+static void genTrue(int n, char *t) {
+    char label[16];
+    Node *np;
+
+    np = &nodes[n];
+    switch (np->kind) {
+    case Node_Leaf:
+        genLeaf(np, np->cond, t);
+        break;
+    case Node_Or:
+        genTrue(np->a, t);
+        genTrue(np->b, t);
+        break;
+    case Node_And:
+        newLabel(label);
+        genFalse(np->a, label);
+        genTrue(np->b, t);
+        putLine(label, "=", "*");
+        break;
+    case Node_Not:
+        genFalse(np->a, t);
+        break;
+    }
+}
+
+static int isLaterLeafOk(int n, int *first) {
+    Node *np;
+
+    np = &nodes[n];
+    if (np->kind != Node_Leaf) {
+        if (!isLaterLeafOk(np->a, first)) return 0;
+        return np->kind == Node_Not || isLaterLeafOk(np->b, first);
+    }
+    if (*first) {
+        *first = 0;
+        return np->codeFirst == 0;   /* the relation that always runs */
+    }
+    return isSelfContained(np);
+}
+
+/*
+ *  Rewrite a block of count lines that ends in S0 Sr and JSZ.  Returns 1
+ *  if it was written out as jumps, 0 if it is to be copied as it is.
+ */
+static int rewrite(Line *lp, int count) {
+    char *bodyLabel;
+    int bodyCount;
+    int codeFirst;
+    int first;
+    int i;
+    int live;
+    int r;
+    int regNodes[8];
+    Node *np;
+
+    region = lp;
+    bodyCount = count - 2;
+    if (!isReg(lp[bodyCount].f2, 'S', 1) || lp[bodyCount].label[0] != '\0' || lp[bodyCount + 1].label[0] != '\0') return 0;
+    for (i = 0; i < 8; i++) regNodes[i] = -1;
+    nodeCount = 0;
+    codeFirst = 0;
+    first = 1;
+    i = 0;
+    while (i < bodyCount) {
+        if (i + 3 < bodyCount && isMaterialization(&lp[i])) {
+            if (nodeCount >= MAX_NODES) return 0;
+            np = &nodes[nodeCount];
+            np->kind = Node_Leaf;
+            np->codeFirst = codeFirst;
+            np->codeCount = i - codeFirst;
+            np->test = i;
+            strcpy(np->cond, lp[i + 2].f1);
+            r = lp[i + 1].f1[1] - '0';
+            if (regNodes[r] != -1) return 0;
+            regNodes[r] = nodeCount++;
+            i += 4;
+            codeFirst = i;
+            first = 0;
+            continue;
+        }
+        if (!first && codeFirst == i && isReg(lp[i].f1, 'S', 1) && lp[i].label[0] == '\0') {
+            char *f2 = lp[i].f2;
+            int a, b;
+            NodeKind kind;
+
+            kind = Node_Leaf;
+            if (f2[0] == 'S' && f2[3] == 'S' && (f2[2] == '&' || f2[2] == '!') && f2[5] == '\0') {
+                a = f2[1] - '0';
+                b = f2[4] - '0';
+                if (a >= 1 && a <= 7 && b >= 1 && b <= 7 && a != b && regNodes[a] != -1 && regNodes[b] != -1) {
+                    kind = (f2[2] == '&') ? Node_And : Node_Or;
+                }
+            }
+            else if (f2[0] == '#' && f2[1] == 'S' && f2[3] == '\0') {
+                a = f2[2] - '0';
+                b = -1;
+                if (a >= 1 && a <= 7 && regNodes[a] != -1) kind = Node_Not;
+            }
+            if (kind != Node_Leaf) {
+                if (nodeCount >= MAX_NODES) return 0;
+                np = &nodes[nodeCount];
+                np->kind = kind;
+                np->a = regNodes[a];
+                np->b = (b > 0) ? regNodes[b] : -1;
+                regNodes[a] = -1;
+                if (b > 0) regNodes[b] = -1;
+                r = lp[i].f1[1] - '0';
+                if (regNodes[r] != -1) return 0;
+                regNodes[r] = nodeCount++;
+                i += 1;
+                codeFirst = i;
+                continue;
+            }
+        }
+        if (!first) {
+            if (!isPlain(&lp[i])) return 0;
+            r = lp[i].f1[1] - '0';
+            if (lp[i].f1[0] == 'S' && regNodes[r] != -1) return 0;
+        }
+        i += 1;
+    }
+    if (first || codeFirst != bodyCount) return 0;
+    r = lp[bodyCount].f2[1] - '0';
+    live = 0;
+    for (i = 1; i < 8; i++) {
+        if (regNodes[i] != -1) live += 1;
+    }
+    if (live != 1 || regNodes[r] == -1) return 0;
+    first = 1;
+    if (!isLaterLeafOk(regNodes[r], &first)) return 0;
+    bodyLabel = lp[bodyCount + 1].f2;
+    genFalse(regNodes[r], bodyLabel);
+    return 1;
+}
+
+static void copyLines(int first, int last) {
+    int i;
+
+    for (i = first; i < last; i++) fprintf(out, "%s\n", lines[i].text);
+}
+
+/*
+ *  Rewrite the compiled program in path.
+ */
+static char *readLine(FILE *in) {
+    int c;
+    char *buf;
+    int len;
+    int size;
+
+    size = 128;
+    buf = (char *)malloc(size);
+    len = 0;
+    while (buf != NULL && (c = getc(in)) != EOF && c != '\n') {
+        if (len + 1 >= size) {
+            size *= 2;
+            buf = (char *)realloc(buf, size);
+            if (buf == NULL) return NULL;
+        }
+        buf[len++] = c;
+    }
+    if (buf == NULL) return NULL;
+    if (c == EOF && len == 0) {
+        free(buf);
+        return NULL;
+    }
+    buf[len] = '\0';
+    return buf;
+}
+
+void compileConditionsToJumps(char *path) {
+    char *cp;
+    FILE *in;
+    int i;
+    int limit;
+    int start;
+
+    in = fopen(path, "r");
+    if (in == NULL) return;
+    limit = 1024;
+    lines = (Line *)malloc(limit * sizeof(Line));
+    lineCount = 0;
+    while (lines != NULL && (cp = readLine(in)) != NULL) {
+        if (lineCount >= limit) {
+            limit *= 2;
+            lines = (Line *)realloc(lines, limit * sizeof(Line));
+            if (lines == NULL) break;
+        }
+        parseLine(&lines[lineCount++], cp);
+    }
+    fclose(in);
+    if (lines == NULL) return;   /* out of memory: the program stays as it is */
+
+    out = fopen(path, "w");
+    if (out == NULL) return;
+    start = 0;
+    for (i = 0; i < lineCount; i++) {
+        Line *lp = &lines[i];
+        if (!lp->isComment && lp->label[0] == '\0' && strcmp(lp->f1, "JSZ") == 0
+            && i > start && strcmp(lines[i - 1].f1, "S0") == 0) {
+            if (!rewrite(&lines[start], i + 1 - start)) copyLines(start, i + 1);
+            start = i + 1;
+        }
+        else if (!isCode(lp) && !(isJump(lp->f1) && strcmp(lp->f2, "*+3") == 0 && lp->label[0] == '\0')) {
+            copyLines(start, i + 1);
+            start = i + 1;
+        }
+    }
+    copyLines(start, lineCount);
+    fclose(out);
+    for (i = 0; i < lineCount; i++) free(lines[i].text);
+    free(lines);
+}
