+/*
+ *  The bit functions of Cray FORTRAN and of MIL-STD-1753, which take and
+ *  give words: AND, OR, XOR and NOT with their other names, and ISHFT.
+ *  They are compiled in line unless the program has a routine or a
+ *  variable of the name.
+ */
+#define BitFn_And   1
+#define BitFn_Or    2
+#define BitFn_Xor   3
+#define BitFn_Not   4
+#define BitFn_Shift 5
+
+static int bitFunctionId(char *name) {
+    if (strcasecmp(name, "AND") == 0 || strcasecmp(name, "IAND") == 0) return BitFn_And;
+    if (strcasecmp(name, "OR")  == 0 || strcasecmp(name, "IOR")  == 0) return BitFn_Or;
+    if (strcasecmp(name, "XOR") == 0 || strcasecmp(name, "IEOR") == 0) return BitFn_Xor;
+    if (strcasecmp(name, "NOT") == 0 || strcasecmp(name, "COMPL") == 0) return BitFn_Not;
+    if (strcasecmp(name, "ISHFT") == 0) return BitFn_Shift;
+    return 0;
+}
+
+/*
+ *  MIN and MAX (MIN0, MAX0) and ABS (IABS) of integers are compiled in
+ *  line: a compare and a jump for each argument after the first, or for
+ *  the sign.  Each was a call with the arguments' addresses in a list.
+ *  Other arguments go to the library.
+ */
+static int minMaxId(char *name) {
+    if (strcasecmp(name, "MIN") == 0 || strcasecmp(name, "MIN0") == 0) return 1;
+    if (strcasecmp(name, "MAX") == 0 || strcasecmp(name, "MAX0") == 0) return 2;
+    if (strcasecmp(name, "ABS") == 0 || strcasecmp(name, "IABS") == 0) return 3;
+    return 0;
+}
+
+static bool isIntegerExpr(Token *t) {
+    char *name;
+    DataType *dt;
+    TokenListItem *q;
+    Symbol *symbol;
+
+    if (t == NULL) return FALSE;
+    switch (t->type) {
+    case TokenType_Constant:
+        return t->details.constant.dt.type == BaseType_Integer;
+    case TokenType_Identifier:
+        if (t->details.identifier.range != NULL) return FALSE;
+        name = t->details.identifier.name;
+        symbol = findSymbol(name);
+        if (t->details.identifier.qualifiers != NULL
+            && (symbol == NULL || (symbol->class == SymClass_Undefined && getSymbolType(symbol)->rank == 0))) {
+            if (bitFunctionId(name) != 0) return TRUE;
+            if (minMaxId(name) == 0) return FALSE;
+            for (q = t->details.identifier.qualifiers; q != NULL; q = q->next) {
+                if (q->item != NULL && !isIntegerExpr(q->item)) return FALSE;
+            }
+            return TRUE;
+        }
+        if (symbol == NULL) symbol = addSymbol(name, SymClass_Undefined);
+        if (symbol->class != SymClass_Undefined && symbol->class != SymClass_Auto
+            && symbol->class != SymClass_Static && symbol->class != SymClass_Adjustable
+            && symbol->class != SymClass_Global && symbol->class != SymClass_Argument
+            && symbol->class != SymClass_Parameter) return FALSE;
+        dt = getSymbolType(symbol);
+        if (dt->type != BaseType_Integer) return FALSE;
+        return (t->details.identifier.qualifiers == NULL) ? dt->rank == 0 : dt->rank > 0;
+    case TokenType_Operator:
+        switch (t->details.operator.id) {
+        case OP_ADD:
+        case OP_SUB:
+        case OP_MUL:
+        case OP_DIV:
+            return isIntegerExpr(t->details.operator.leftArg) && isIntegerExpr(t->details.operator.rightArg);
+        case OP_NEG:
+        case OP_PLUS:
+        case OP_SEXPR:
+            return isIntegerExpr(t->details.operator.rightArg);
+        default:
+            return FALSE;
+        }
+    default:
+        return FALSE;
+    }
+}
+
+static bool evaluateMinMax(Token *fn, int id) {
+    OperatorArgument acc;
+    OperatorArgument arg;
+    int count;
+    int n;
+    TokenListItem *qualifier;
+
+    count = 0;
+    for (qualifier = fn->details.identifier.qualifiers; qualifier != NULL; qualifier = qualifier->next) {
+        if (qualifier->item != NULL) count += 1;
+    }
+    if ((id == 3) ? count != 1 : count < 2) {
+        err("Wrong number of arguments to %s", fn->details.identifier.name);
+        return TRUE;
+    }
+    n = 0;
+    for (qualifier = fn->details.identifier.qualifiers; qualifier != NULL; qualifier = qualifier->next) {
+        if (qualifier->item == NULL) continue;
+        if (evaluateExpression(qualifier->item, &arg)) {
+            if (n > 0) freeRegister(acc.reg);
+            return TRUE;
+        }
+        loadValue(&arg);
+        if (n == 0) {
+            acc = arg;
+            if (id == 3) emitAbsInt(acc.reg);
+        }
+        else {
+            emitMinMaxInt(acc.reg, arg.reg, id == 2);
+            freeRegister(arg.reg);
+        }
+        n += 1;
+    }
+    acc.class = ArgClass_Calculation;
+    acc.details.calculation.type = BaseType_Integer;
+    acc.details.calculation.rank = 0;
+    pushArg(&acc);
+
+    return FALSE;
+}
+
+static bool evaluateBitFunction(Token *fn, int id) {
+    OperatorArgument args[2];
+    int count;
