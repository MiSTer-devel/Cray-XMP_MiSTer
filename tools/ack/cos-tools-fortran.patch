+/*
+ *  The bit functions of Cray FORTRAN and of MIL-STD-1753, which take and
+ *  give words: AND, OR, XOR and NOT with their other names, and ISHFT.
+ *  They are compiled in line unless the program has a routine or a
+ *  variable of the name.
+ */
+#define BitFn_And   1
+#define BitFn_Or    2
+#define BitFn_Xor   3
+#define BitFn_Not   4
+#define BitFn_Shift 5
+
+static int bitFunctionId(char *name) {
+    if (strcasecmp(name, "AND") == 0 || strcasecmp(name, "IAND") == 0) return BitFn_And;
+    if (strcasecmp(name, "OR")  == 0 || strcasecmp(name, "IOR")  == 0) return BitFn_Or;
+    if (strcasecmp(name, "XOR") == 0 || strcasecmp(name, "IEOR") == 0) return BitFn_Xor;
+    if (strcasecmp(name, "NOT") == 0 || strcasecmp(name, "COMPL") == 0) return BitFn_Not;
+    if (strcasecmp(name, "ISHFT") == 0) return BitFn_Shift;
+    return 0;
+}
+
+static bool evaluateBitFunction(Token *fn, int id) {
+    OperatorArgument args[2];
+    int count;
+    BaseType type;
+    int i;
+    int n;
+    TokenListItem *qualifier;
+    OperatorArgument result;
+
+    n = 0;
+    for (qualifier = fn->details.identifier.qualifiers; qualifier != NULL; qualifier = qualifier->next) {
+        if (qualifier->item == NULL) continue;
+        if (n >= 2 || evaluateExpression(qualifier->item, &args[n])) {
+            if (n >= 2) err("Too many arguments to %s", fn->details.identifier.name);
+            for (i = 0; i < n && i < 2; i++) {
+                if (isCalculation(args[i])) freeRegister(args[i].reg);
+            }
+            return TRUE;
+        }
+        type = getDataType(&args[n])->type;
+        if (type == BaseType_Character || type == BaseType_Complex) {
+            err("Invalid argument to %s", fn->details.identifier.name);
+            return TRUE;
+        }
+        /* the first is loaded before the second is looked at, so that it
+           holds no address register meanwhile */
+        if (n == 0) loadValue(&args[0]);
+        n += 1;
+    }
+    if (n != ((id == BitFn_Not) ? 1 : 2)) {
+        err("Wrong number of arguments to %s", fn->details.identifier.name);
+        return TRUE;
+    }
+    if (id == BitFn_Shift && isConstant(args[1]) && args[1].details.constant.dt.type == BaseType_Integer) {
+        count = (args[1].details.constant.value.integer > 64) ? 64
+              : (args[1].details.constant.value.integer < -64) ? -64
+              : (int)args[1].details.constant.value.integer;
+        emitShiftConst(args[0].reg, count);
+        result = args[0];
+    }
+    else {
+        if (n > 1) loadValue(&args[1]);
+        switch (id) {
+        case BitFn_And:
+            emitAndInt(&args[0], &args[1]);
+            break;
+        case BitFn_Or:
+            emitOrInt(&args[0], &args[1]);
+            break;
+        case BitFn_Xor:
+            emitXorInt(&args[0], &args[1]);
+            break;
+        case BitFn_Not:
+            emitNotReg(args[0].reg, BaseType_Integer);
+            break;
+        default:
+            emitShiftReg(args[0].reg, args[1].reg);
+            break;
+        }
+        if (id == BitFn_Not || id == BitFn_Shift) {
+            result = args[0];
+            if (n > 1) freeRegister(args[1].reg);
+        }
+        else {
+            result = args[1];
+            freeRegister(args[0].reg);
+        }
+    }
+    result.class = ArgClass_Calculation;
+    result.details.calculation.type = BaseType_Integer;
+    result.details.calculation.rank = 0;
+    pushArg(&result);
+
+    return FALSE;
+}
