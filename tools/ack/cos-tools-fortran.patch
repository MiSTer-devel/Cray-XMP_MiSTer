+
+static int daReserve(DaFile *fp, int recs) {
+    int i;
+    int n;
+    char **nt;
+    char *piece;
+
+    while (recs > fp->recs) {
+        n = fp->recs >> DA_PIECE_SHIFT;
+        if ((n & (n - 1)) == 0) { /* the table of pieces is full: twice the size */
+            nt = (char **)malloc(((n > 0) ? n * 2 : 1) * sizeof(char *));
+            if (nt == NULL) return ENOMEM;
+            for (i = 0; i < n; i++) nt[i] = fp->pieces[i];
+            if (fp->pieces != NULL) free(fp->pieces);
+            fp->pieces = nt;
