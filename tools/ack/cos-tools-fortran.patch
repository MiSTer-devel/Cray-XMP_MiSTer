+/*
+ *  Direct access records.  Record n is the recLen bytes from byte
+ *  (n - 1) * recLen of the file; a formatted record is blank-filled and
+ *  has no line end.
+ */
+static int daReserve(Unit *up, int recs) {
+    int n;
+    char *nb;
+
+    if (recs <= up->daRecs) return 0;
+    n = (up->daRecs > 0) ? up->daRecs : 8;
+    while (n < recs) n *= 2;
+    nb = (char *)malloc(n * up->recLen);
+    if (nb == NULL) return ENOMEM;
+    memset(nb, (up->flags & MASK_UNFORMATTED) != 0 ? 0 : ' ', n * up->recLen);
+    if (up->daBuf != NULL) {
+        memcpy(nb, up->daBuf, up->daRecs * up->recLen);
+        free(up->daBuf);
+    }
+    up->daBuf = nb;
+    up->daRecs = n;
+    return 0;
+}
+
+static int daRead(Unit *up, char *dst, int n) {
+    if (up->daRec > up->daMax) return -1; /* no such record */
+    if (up->daPos + n > up->recLen) return EIO; /* longer than a record */
+    memcpy(dst, up->daBuf + (up->daRec - 1) * up->recLen + up->daPos, n);
+    up->daPos += n;
+    return 0;
+}
+
+static int daWrite(Unit *up, char *src, int n) {
+    int rc;
+
+    if (up->daPos + n > up->recLen) return EIO; /* longer than a record */
+    rc = daReserve(up, up->daRec);
+    if (rc != 0) return rc;
+    memcpy(up->daBuf + (up->daRec - 1) * up->recLen + up->daPos, src, n);
+    up->daPos += n;
+    if (up->daRec > up->daMax) up->daMax = up->daRec;
+    up->daDirty = 1;
+    return 0;
+}
+
+static int daLoad(Unit *up) {
+    int fd;
+    int have;
+    int n;
+    int rc;
+
+    fd = open(up->fileName, O_RDONLY|O_BINARY, 0);
+    if (fd == -1) return errno;
+    have = 0;
+    rc = 0;
+    for (;;) {
+        rc = daReserve(up, have / up->recLen + 1);
+        if (rc != 0) break;
+        n = read(fd, up->daBuf + have, up->daRecs * up->recLen - have);
+        if (n < 0) {
+            rc = errno;
+            break;
+        }
+        if (n == 0) break;
+        have += n;
+    }
+    close(fd);
+    up->daMax = have / up->recLen;
+    return rc;
+}
+
+static int daSave(Unit *up) {
+    int fd;
+    int len;
+    int rc;
+
+    fd = open(up->fileName, O_CREAT|O_TRUNC|O_WRONLY|O_BINARY, 0640);
+    if (fd == -1) return errno;
+    rc = 0;
+    len = up->daMax * up->recLen;
+    if (len > 0 && write(fd, up->daBuf, len) != len) rc = errno;
+    if (close(fd) == -1 && rc == 0) rc = errno;
+    return rc;
+}
