+//
+//  Blank common is allocated last, after all other blocks, at the length of
+//  its longest declaration, as the CRAY loader does it.  No data can be
+//  stored in it at load time, so the binary ends where it begins: the
+//  binary's high limit includes it, and the system gives the program that
+//  memory when it loads it.
+//
+static void calculateBlankCommonAddress(Block *block) {
+    u32 length;
+
+    length = 0;
+    for (; block != NULL; block = block->nextInImage) {
+        if (isBlankCommon(block) && !block->isAbsolute) {
+            block->baseAddress = blockLimit;
+            if (block->length > length) length = block->length;
+        }
+    }
+    blockLimit += length;
+    if (blockLimit > imageSize) imageSize = blockLimit;
+}
+
+static bool isBlankCommon(Block *block) {
+    int i;
+
+    for (i = 0; i < 8; i++) {
+        if (block->id[i] != ' ' && block->id[i] != '\0') return FALSE;
+    }
+    return TRUE;
+}
