diff --git a/ldr.c b/ldr.c
index 0e68c47..5e78210 100644
--- a/ldr.c
+++ b/ldr.c
@@ -1427,11 +1427,18 @@ static int processBRT(Dataset *ds, u64 hdr, int tableLength) {
                            | (image[imageOffset+1] << 16)
                            | (image[imageOffset+2] <<  8)
                            |  image[imageOffset+3];
+                //
+                //  The address is the low 24 bits of the two parcels when it
+                //  counts parcels and the low 22 when it counts words. The
+                //  sum stays in them: an address written as a symbol less a
+                //  constant wraps around, and what is above the address (the
+                //  register of the instruction) is not part of it.
+                //
                 if (isParcelRelocation) {
-                    imageBytes += block->baseAddress << 2;
+                    imageBytes = (imageBytes & ~0xffffff) | ((imageBytes + (block->baseAddress << 2)) & 0xffffff);
                 }
                 else {
-                    imageBytes += block->baseAddress;
+                    imageBytes = (imageBytes & ~0x3fffff) | ((imageBytes + block->baseAddress) & 0x3fffff);
                 }
                 image[imageOffset  ] =  imageBytes >> 24;
                 image[imageOffset+1] = (imageBytes >> 16) & 0xff;
