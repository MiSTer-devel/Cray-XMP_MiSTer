diff --git a/cosdataset.c b/cosdataset.c
index c9675d2..ce7f051 100644
--- a/cosdataset.c
+++ b/cosdataset.c
@@ -352,7 +352,7 @@ int cosDsWriteEOF(Dataset *ds) {
 
