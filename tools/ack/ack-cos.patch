diff --color -ruN a/plat/cos/libsys/write.c b/plat/cos/libsys/write.c
--- a/plat/cos/libsys/write.c	2026-10-11 12:31:11.231643864 -0400
+++ b/plat/cos/libsys/write.c	2026-10-11 12:31:47.905405145 -0400
@@ -7,7 +7,49 @@
 
 #define MAX_LOG_MSG_SIZE 128
 
+/*
+ *  An interactive dataset (DPIA, bit 35 of word 1 of its DSP) takes
+ *  circular I/O only: buffered I/O (F$BIO) is refused on it.  The data
+ *  goes into the buffer COS-blocked, as the system itself delivers
+ *  interactive input: a block control word whose forward index counts
+ *  the data words, the data, and a record control word (mode 10 octal,
+ *  end of record, with the unused bit count of the last word in bits
+ *  4-9 and a forward index of zero).  Every write makes a record, so a
+ *  partial write of a full data area breaks a line there.
+ */
+#define DSP_IA(dsp) ((((dsp)->first) >> 28) & 1)
+#define DSP_ADDR(w) ((w) & 0xffffff)
+
+static void putWord(DSP *dsp, u64 *in, u64 w) {
+    *(u64 *)_wp2bp(*in) = w;
+    *in += 1;
+    if (*in >= DSP_ADDR(dsp->limit)) *in = DSP_ADDR(dsp->first);
+}
+
+static int writeCircular(FtEntry *entry, DSP *dsp, int wc, int unusedBits) {
+    int i;
+    u64 in;
+    u64 w;
+    u64 w1;
+
+    in = DSP_ADDR(dsp->in);
+    putWord(dsp, &in, (u64)wc);
+    for (i = 0; i < wc; i++) {
+        memcpy(&w, entry->uda + i * 8, 8);
+        putWord(dsp, &in, w);
+    }
+    putWord(dsp, &in, (010UL << 60) | ((u64)unusedBits << 54));
+    dsp->in = (dsp->in & ~0xffffffUL) | in;
+    w1 = _coswdc(dsp);
+    if (((w1 >> 51) & 0xfff) != 0) {
+        errno = EIO;
+        return -1;
+    }
+    return wc;
+}
+
