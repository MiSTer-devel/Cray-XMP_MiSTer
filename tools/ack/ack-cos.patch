+++ b/lang/cem/libcc.ansi/sys/malloc/realloc.c
@@ -27,17 +27,21 @@ void* realloc(void* ptr, size_t size)
 	/* Overflow check. */
 	if (nblocks < size)
 		return NULL;
+	/* BLOCKCOUNT counts bytes; a block's size is in blocks, as malloc() has it. */
+	nblocks /= sizeof(block_t);
 
 	/* Shrinking the block? Don't bother doing anything (it's never worth it). */
 	if (nblocks <= h->size)
 		return ptr;
 
-	/* Allocate and copy. */
+	/* Allocate and copy what the old block holds: its size less the header.
+	 * (With the header counted in, a new block of as many blocks as the old
+	 * one was written one block past its end.) */
 
 	newptr = malloc(size);
 	if (!newptr)
 		return NULL;
-	memcpy(newptr, ptr, h->size * sizeof(block_t));
+	memcpy(newptr, ptr, (h->size - 1) * sizeof(block_t));
 	free(ptr);
 	return newptr;
 }
