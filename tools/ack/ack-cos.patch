+/*
+ *  An interactive dataset (DPIA, bit 35 of word 1 of its DSP) takes
+ *  circular I/O only: buffered I/O (F$BIO) is refused on it.  The
+ *  system fills the buffer with COS-blocked data, which is unblocked
+ *  here: a block control word (first byte zero) is skipped, a record
+ *  control word (top bit set, mode in bits 0-3: 10 octal end of record
+ *  with the unused bit count in bits 4-9, 16 end of file, 17 end of
+ *  data) ends the segment, and every other word is data.  The forward
+ *  indexes of the control words are not trusted; interactive input
+ *  leaves them zero.
+ */
+#define DSP_IA(dsp) ((((dsp)->first) >> 28) & 1)
+#define DSP_ADDR(w) ((w) & 0xffffff)
+
+static int readCircular(FtEntry *entry, DSP *dsp) {
+    u64 first;
+    u64 in;
+    u64 limit;
+    int mode;
+    int n;
+    u64 out;
+    u64 w;
+    u64 w1;
+
+    entry->out = entry->in = 0;
+    entry->unusedBits = 0;
+    first = DSP_ADDR(dsp->first);
+    limit = DSP_ADDR(dsp->limit);
+    n = 0;
+    for (;;) {
+        in  = DSP_ADDR(dsp->in);
+        out = DSP_ADDR(dsp->out);
+        if (in == out) { /* the buffer is empty: ask for more */
+            w1 = _cosrdc(dsp);
+            if ((w1 & (1UL << 62)) != 0) { /* DPEOI: end of data */
+                entry->status = COS_EOD;
+                break;
+            }
+            if (((w1 >> 51) & 0xfff) != 0) {
+                errno = EIO;
+                return -1;
+            }
+            continue;
+        }
+        w = *(u64 *)_wp2bp(out);
+        out += 1;
+        if (out >= limit) out = first;
+        dsp->out = (dsp->out & ~0xffffffUL) | out;
+        if ((w >> 63) != 0) { /* a record control word */
+            mode = (int)((w >> 60) & 7);
+            if (mode == 0) {
+                entry->status = COS_EOR;
+                entry->unusedBits = (w >> 54) & 0x3f;
+            }
+            else if (mode == 6) {
+                entry->status = COS_EOF;
+            }
+            else {
+                entry->status = COS_EOD;
+            }
+            break;
+        }
+        if ((w >> 56) == 0) continue; /* a block control word */
+        memcpy(entry->uda + n * 8, &w, 8);
+        n += 1;
+        if (n >= COS_UDA_SIZE) break; /* a partial record */
+    }
+    entry->in = n * 8;
+    if (entry->status == COS_EOR) {
+        entry->in -= entry->unusedBits >> 3;
+    }
+    return n;
+}
