 * System function numbers
 F$ADV:    = 0                ; advance to next job step
 F$ABT:    = 1                ; abort job
+F$MEMORY: = O'073            ; request memory
+
+* The heap grows up from the program's high limit and the stack down from
+* the system's tables at the top of the field length.  COS leaves a small
+* program the field length of its control statement processor, which is
+* room enough, but a program larger than that gets a few thousand words
+* and cannot open a file.  When fewer than this many words are free at
+* the start, the rest is asked for: COS adds it to the end of the user
+* area, which moves the high limit and the tables up.
+MIN%FREE: = O'120000
 
           ext      @%ftFini
           ext      @%ftInit
@@ -21,6 +31,27 @@
 %%start:  =        *
           start    %%start
 *
+*  The heap begins at the program's high limit.  Ask for memory when
+*  too little is free above it.
+*
+          s2       <24
+          s1       JCHLM,    ; high limit of the program
+          s1       s1>24
+          s1       s1&s2
+          heapb,   s1
+          s3       JCLFT,    ; base of the system-managed LFT's
+          s3       s3&s2
+          s3       s3-s1     ; words free between them
+          s1       MIN%FREE
+          s0       s3-s1
+          jsp      %%init    ; if enough
+          s1       s1-s3     ; words to add to the user area
+          memreq,  s1
+          s1       memreq
+          s0       F$MEMORY
+          ex
+%%init:   =        *
+*
 *  Initialize local base, stack pointer, and heap pointer
 *
           s1       JCLFT,    ; preset stack pointer to base of system-managed LFT's
@@ -30,9 +61,7 @@
           s3       s3-s1
           a7       s3
           a6       a7        ; preset local base to stack pointer
-          s1       JCHLM,    ; preset heap pointer to current field length
-          s1       s1>24
-          s3       s1&s2
+          s3       heapb,    ; preset heap pointer to the program's high limit
