diff --git a/lang/cem/libcc.ansi/core/string/memset.c b/lang/cem/libcc.ansi/core/string/memset.c
index 649f8c7..39db9ef 100644
--- a/lang/cem/libcc.ansi/core/string/memset.c
+++ b/lang/cem/libcc.ansi/core/string/memset.c
@@ -6,6 +6,46 @@
 
 #include <string.h>
 
+#if defined(__cos)
+/*
+ *  On the CRAY whole words are filled: the first is stored, and the
+ *  library's block move, which goes up a word at a time, copies each
+ *  word from the one before it.
+ */
+extern void _bcopy(void* dst, void* src, int ct);
+
+void* memset(void* s, register int c, register size_t n)
+{
+	register char* s1 = s;
+	unsigned long w;
+	size_t words;
+
+	while (n > 0 && ((unsigned long)s1 & 7) != 0)
+	{
+		*s1++ = c;
+		n--;
+	}
+	if (n >= 8)
+	{
+		w = (unsigned char)c;
+		w |= w << 8;
+		w |= w << 16;
+		w |= w << 32;
+		*(unsigned long*)s1 = w;
+		words = n >> 3;
+		if (words > 1)
+			_bcopy(s1 + 8, s1, (int)((words - 1) << 3));
+		s1 += words << 3;
+		n &= 7;
+	}
+	while (n > 0)
+	{
+		*s1++ = c;
+		n--;
+	}
+	return s;
+}
+#else
 void* memset(void* s, register int c, register size_t n)
 {
 	register char* s1 = s;
@@ -20,3 +60,4 @@ void* memset(void* s, register int c, register size_t n)
 	}
 	return s;
 }
+#endif
