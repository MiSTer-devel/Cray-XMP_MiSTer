 }
 
+/* The data area is full: write it as a partial record. */
+static int putFull(FtEntry *entry) {
+    DSP *dsp;
+
+    dsp = _getdsp(entry);
+    if (DSP_IA(dsp)) {
+        if (writeCircular(entry, dsp, COS_UDA_SIZE, 0) != COS_UDA_SIZE) {
+            entry->in = 0;
+            errno = EIO;
+            return -1;
+        }
+    }
+    else if (_coswdp(entry, entry->uda, COS_UDA_SIZE) != COS_UDA_SIZE) {
+        entry->in = 0;
+        errno = EIO;
+        return -1;
+    }
+    entry->in = 0;
+    return 0;
+}
+
 ssize_t write(int fd, void *buffer, size_t count) {
     u8 *bp;
     u8 byte;
@@ -68,12 +139,7 @@
             entry->position += n;
             if (entry->position > entry->maxPosition) entry->maxPosition = entry->position;
             if (entry->in >= COS_UDA_SIZE_BYTES) {
-                if (_coswdp(entry, entry->uda, COS_UDA_SIZE) != COS_UDA_SIZE) {
