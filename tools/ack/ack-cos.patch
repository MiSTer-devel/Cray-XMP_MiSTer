+*
+*  %udm
+*
+*  Entry
+*    S1 : dividend
+*    S2 : divisor, not zero
+*
+*  Exit
+*    S7 : quotient
+*    S1 : remainder
+*
+*  Uses S0, S3, A0, A1.  S2 and S6 are as they were.
+*
+%udm:    bss       0
+         a7        a7-1           ; two more registers are needed
+         ,a7       s4
+         a7        a7-1
+         ,a7       s5
+         s0        s1!s2
+         s0        s0>46
+         jsn       6f             ; if too large for floating point
+         s7        0
+         s0        s1-s2
+         jsm       5f             ; if dividend < divisor
+         s3        o'40060        ; both in floating point
