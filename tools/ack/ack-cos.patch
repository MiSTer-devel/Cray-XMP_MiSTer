+         s7        s3!s1
+         s7        +Fs7
+         s3        s3!s2
+         s3        +Fs3
+         s4        /Hs3           ; reciprocal of the divisor
+         s7        s7*Fs4
+         s3        s3*Is4         ; its correction
+         s7        s7*Fs3         ; quotient
+         s3        s7             ; cut off to an integer
+         s3        s3>48
+         s4        o'40060
+         s4        s4-s3
+         a1        s4
+         s3        <48
+         s7        s7&s3
+         s7        s7>a1          ; the guess
+         s0        s7
+         jsz       3f             ; if it is zero
+         a1        zs7            ; guess * divisor: shifts that add up to 48
+         s3        a1
+         s4        16
+         s3        s3-s4
+         a1        s3
+         s5        s7
+         s5        s5<a1
+         s4        48
+         s4        s4-s3
+         a1        s4
+         s4        s2
+         s4        s4<a1
+         s5        s5*Fs4
+         s1        s1-s5          ; what is left over
+3:
+         s4        1
+         s0        s1
+         jsp       4f
+         s1        s1+s2          ; guess too large
+         s7        s7-s4
+         j         3b
+4:
+         s0        s1-s2
+         jsm       5f             ; if less than the divisor: done
+         s1        s1-s2          ; guess too small
+         s7        s7+s4
+         j         4b
+5:
+         s5        ,a7
+         a7        a7+1
+         s4        ,a7
+         a7        a7+1
+         j         b00
+*
+*  Numbers of more than 46 bits: a bit at a time, or, when the divisor
+*  has one of its two top bits, by taking it away as often as it goes.
+*
+6:
+         s7        0
+         s5        1
+         s3        s2
+         s3        s3>62
+         s0        s3
+         jsn       9f             ; if divisor >= 2**62
+         s3        0
+         s4        64
+         a1        1
+7:
+         s3        s3,s1<a1
+         s1        s1<1
+         s7        s7<1
+         s0        s3-s2
+         jsm       8f
+         s3        s3-s2
+         s7        s7!s5
+8:
+         s4        s4-s5
+         s0        s4
+         jsn       7b
+         s1        s3
+         j         5b
+9:
+         s3        s1\s2
+         s0        s3
+         jsm       1f             ; if their top bits differ
+         s0        s1-s2
+         jsm       5b             ; if dividend < divisor
+2:
+         s1        s1-s2
+         s7        s7+s5
+         j         9b
+1:
+         s0        s1
+         jsm       2b             ; if the dividend has the top bit
+         j         5b
+
          end
