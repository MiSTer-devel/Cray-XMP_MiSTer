diff --color -ruN a/plat/cos/libsys/cosrdc.s b/plat/cos/libsys/cosrdc.s
--- a/plat/cos/libsys/cosrdc.s	1969-12-31 19:00:00.000000000 -0500
+++ b/plat/cos/libsys/cosrdc.s	2026-10-11 12:31:11.236860600 -0400
@@ -0,0 +1,51 @@
+#include "cos.h"
+
+text:    section   code
+
+**
+*  @%cosrdc - read circular into the buffer of a dataset
+*  @%coswdc - write circular from the buffer of a dataset
+*
+*  Circular I/O is what an interactive dataset takes (buffered I/O,
+*  F$BIO, is refused on one).  The request is made with automatic
+*  recall, and the job is recalled until the busy flag of the DSP is
+*  clear, so that on return the system has taken or delivered what it
+*  will: the DSP's in and out pointers are up to date.
+*
+*  Entry
+*    (SP)   : byte pointer to the DSP
+*
+*  Exit
+*    S7 : word 1 of the DSP (the busy, error and end-of-data flags)
+*
+         entry     @%cosrdc
+@%cosrdc:ENTER
+         s1        1,a7           ; byte address of the DSP
+         s1        s1>3           ; word address
+         s2        1
+         s2        s2<63          ; automatic recall
+         s1        s1!s2
+         s0        F$RDC
+         ex
+         j         cio1
+
+         entry     @%coswdc
+@%coswdc:ENTER
+         s1        1,a7           ; byte address of the DSP
+         s1        s1>3           ; word address
+         s2        1
+         s2        s2<63          ; automatic recall
+         s1        s1!s2
+         s0        F$WDC
+         ex
+cio1:    s1        1,a7
+         s1        s1>3
+         a1        s1
+         s0        1,a1           ; DPBSY is the sign bit of word 1
+         jsp       cio2           ; not busy: the request is complete
+         RECALL    A1
+         j         cio1
+cio2:    s7        1,a1
+         RETURN
+
+         end
